    {
      "value": "\"type\" in ('transaction', 'asset')",
      "name": "accounts_type_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "accounts"
    },
    {
      "value": "\"spending_type\" in ('needs', 'wants')",
      "name": "budgets_spending_type_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "budgets"
    },
    {
      "value": "\"month\" between 1 and 12",
      "name": "budgets_month_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "budgets"
    },
    {
      "value": "\"amount\" >= 0",
      "name": "budgets_amount_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "budgets"
    },
    {
      "value": "cardinality(\"category_ids\") >= 1",
      "name": "budgets_category_ids_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "budgets"
    },
    {
      "value": "\"kind\" in ('income', 'saving', 'spending')",
      "name": "categories_kind_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "categories"
    },
    {
      "value": "(\"spending_type\" is null or \"spending_type\" in ('needs', 'wants')) and (\"kind\" = 'spending') = (\"spending_type\" is not null)",
      "name": "categories_spending_type_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "categories"
    },
    {
      "value": "\"target_amount\" between 1 and 1000000000000",
      "name": "net_worth_amount_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "net_worth"
    },
    {
      "value": "(\"target_year\" is null) = (\"target_month\" is null) and (\"target_month\" is null or \"target_month\" between 1 and 12)",
      "name": "net_worth_target_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "net_worth"
    },
    {
      "value": "cardinality(\"account_ids\") between 1 and 20",
      "name": "net_worth_account_ids_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "net_worth"
    },
    {
      "value": "\"type\" in ('income', 'expense', 'saving')",
      "name": "recurring_rules_type_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "recurring_rules"
    },
    {
      "value": "\"amount\" > 0",
      "name": "recurring_rules_amount_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "recurring_rules"
    },
    {
      "value": "\"day_of_month\" between 1 and 31",
      "name": "recurring_rules_day_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "recurring_rules"
    },
    {
      "value": "not \"is_payday\" or \"type\" = 'income'",
      "name": "recurring_rules_payday_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "recurring_rules"
    },
    {
      "value": "\"type\" in ('income', 'expense', 'saving', 'transfer', 'adjustment', 'revaluation')",
      "name": "transactions_type_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "transactions"
    },
    {
      "value": "case when \"type\" in ('adjustment', 'revaluation') then \"amount\" <> 0 else \"amount\" > 0 end",
      "name": "transactions_amount_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "transactions"
    },
    {
      "value": "(\"type\" = 'transfer') = (\"to_account_id\" is not null)",
      "name": "transactions_transfer_target_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "transactions"
    },
    {
      "value": "(\"type\" in ('transfer', 'adjustment', 'revaluation')) = (\"category_id\" is null)",
      "name": "transactions_category_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "transactions"
    },
    {
      "value": "\"to_account_id\" <> \"account_id\"",
      "name": "transactions_distinct_accounts_check",
      "entityType": "checks",
      "schema": "lontu",
      "table": "transactions"
    },
    {
      "definition": "\n    select a.id as account_id, a.user_id,\n      a.initial_balance + coalesce(sum(case\n        when t.type in ('income', 'adjustment', 'revaluation') then t.amount\n        when t.type in ('expense', 'saving')                   then -t.amount\n        when t.type = 'transfer' and t.account_id = a.id       then -t.amount\n        when t.type = 'transfer' and t.to_account_id = a.id    then t.amount\n      end), 0)::bigint as balance\n    from \"lontu\".\"accounts\" a\n    left join \"lontu\".\"transactions\" t\n      on t.deleted_at is null and (t.account_id = a.id or t.to_account_id = a.id)\n    group by a.id\n  ",
